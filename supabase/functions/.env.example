# Copy to supabase/functions/.env and fill in your LTA DataMall AccountKey.
# Register (free) at https://datamall.lta.gov.sg/ to get one.
# Local:  supabase functions serve bus-arrivals --env-file supabase/functions/.env
# Deployed: supabase secrets set LTA_ACCOUNT_KEY=...
LTA_ACCOUNT_KEY=your-lta-account-key-here
CRON_SECRET=any-long-random-string
